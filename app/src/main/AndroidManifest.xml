<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- only used to download the translation model and check for new versions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Wi-Fi or mobile data, so the setup guide can offer to wait for Wi-Fi -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="false"
        tools:targetApi="33">

        <!-- Needed by LiteRT-LM's GPU backend -->
        <uses-native-library android:name="libvndksupport.so" android:required="false" />
        <uses-native-library android:name="libOpenCL.so" android:required="false" />

        <activity android:name=".MainActivity"
            android:label="@string/app_name"
            android:theme="@style/RomanUrduAppTheme"
            android:windowSoftInputMode="adjustResize"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".SetupActivity"
            android:label="Set up Roman Urdu Keyboard"
            android:theme="@style/RomanUrduAppTheme"
            android:windowSoftInputMode="adjustResize"
            android:exported="false" />

        <!-- a plain text box, used to look at the keyboard (screenshots in CI) -->
        <activity android:name=".PreviewActivity"
            android:label="Keyboard preview"
            android:theme="@style/RomanUrduAppTheme"
            android:windowSoftInputMode="adjustResize"
            android:exported="${previewExported}" />

        <service android:name=".ime.UrduImeService"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_INPUT_METHOD"
            android:exported="true">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data android:name="android.view.im" android:resource="@xml/method" />
        </service>
    </application>
</manifest>
