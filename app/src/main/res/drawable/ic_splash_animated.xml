<?xml version="1.0" encoding="utf-8"?>
<!-- The lantern swings and its glow brightens while the app opens -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/ic_splash_lantern">
    <target android:name="lantern">
        <aapt:attr name="android:animation" xmlns:aapt="http://schemas.android.com/aapt">
            <objectAnimator android:propertyName="rotation" android:valueFrom="-4" android:valueTo="4"
                android:valueType="floatType" android:duration="900" android:interpolator="@android:interpolator/fast_out_slow_in" />
        </aapt:attr>
    </target>
    <target android:name="glow">
        <aapt:attr name="android:animation" xmlns:aapt="http://schemas.android.com/aapt">
            <objectAnimator android:propertyName="alpha" android:valueFrom="0.35" android:valueTo="1"
                android:valueType="floatType" android:duration="900" />
        </aapt:attr>
    </target>
</animated-vector>
