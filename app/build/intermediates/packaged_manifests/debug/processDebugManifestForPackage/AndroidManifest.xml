<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.lanternkeys.urdukb"
    android:versionCode="5001"
    android:versionName="2.0-dev" >

    <uses-sdk
        android:minSdkVersion="31"
        android:targetSdkVersion="37" />

    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- downloading the translation model, checking for new versions, and GIF and sticker search (GIPHY) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Wi-Fi or mobile data, so the setup guide can offer to wait for Wi-Fi -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- voice typing inside the keyboard; asked for only when the mic button is first used -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <permission
        android:name="com.lanternkeys.urdukb.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        android:protectionLevel="signature" />

    <uses-permission android:name="com.lanternkeys.urdukb.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION" />

    <application
        android:name="com.paul.urdukb.UrduApp"
        android:allowBackup="false"
        android:appComponentFactory="androidx.core.app.CoreComponentFactory"
        android:enableOnBackInvokedCallback="false"
        android:extractNativeLibs="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true" >

        <!-- Needed by LiteRT-LM's GPU backend -->
        <uses-native-library
            android:name="libvndksupport.so"
            android:required="false" />
        <uses-native-library
            android:name="libOpenCL.so"
            android:required="false" />

        <activity
            android:name="com.paul.urdukb.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/RomanUrduAppTheme"
            android:windowSoftInputMode="adjustResize" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="com.paul.urdukb.SetupActivity"
            android:exported="true"
            android:label="Set up Roman Urdu Keyboard"
            android:theme="@style/RomanUrduAppTheme"
            android:windowSoftInputMode="adjustResize" />

        <!-- a plain text box, used to look at the keyboard (screenshots in CI) -->
        <activity
            android:name="com.paul.urdukb.PreviewActivity"
            android:exported="true"
            android:label="Keyboard preview"
            android:theme="@style/RomanUrduAppTheme"
            android:windowSoftInputMode="adjustResize" />

        <!-- "Translate to English" in the text selection menu of other apps -->
        <activity
            android:name="com.paul.urdukb.MicPermissionActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- An Urdu voice note shared from WhatsApp (or anywhere) is read out as Urdu text and English -->
        <activity
            android:name="com.paul.urdukb.VoiceActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="Roman Urdu Keyboard"
            android:taskAffinity=""
            android:theme="@style/RomanUrduSheetTheme" >
            <intent-filter>
                <action android:name="android.intent.action.SEND" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="audio/*" />
            </intent-filter>
        </activity>
        <activity
            android:name="com.paul.urdukb.TranslateTextActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="Translate to English"
            android:taskAffinity=""
            android:theme="@style/RomanUrduSheetTheme" >
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.lanternkeys.urdukb.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true" >
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <service
            android:name="com.paul.urdukb.ime.UrduImeService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_INPUT_METHOD" >
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>

            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="com.lanternkeys.urdukb.androidx-startup"
            android:exported="false" >
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.lifecycle.ProcessLifecycleInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.profileinstaller.ProfileInstallerInitializer"
                android:value="androidx.startup" />
        </provider>

        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            android:directBootAware="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.DUMP" >
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.INSTALL_PROFILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SKIP_FILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SAVE_PROFILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.BENCHMARK_OPERATION" />
            </intent-filter>
        </receiver>
    </application>

</manifest>